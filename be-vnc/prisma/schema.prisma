// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Items {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  slug       String       @unique
  bill_items Bill_items[]

  @@map("items")
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  slug  String  @unique
  users Users[]

  @@map("roles")
}

model Company {
  id                          Int      @id @default(autoincrement())
  name                        String   @unique
  primary_mobile_no           String?
  secondary_mobile_no         String?
  primary_email               String?
  secondary_email             String?
  address                     String?
  pin_code                    String?
  city                        String?
  state                       String?
  gst_number                  String?
  seller_commision_percentage Float?
  buyer_commision_percentage  Float?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("company")
}

// Example model — replace with your own
model Users {
  id                  Int          @id @default(autoincrement())
  roleId              Int
  role                Roles        @relation(fields: [roleId], references: [id])
  name                String?
  primary_mobile_no   String?
  secondary_mobile_no String?
  address             String?
  pin_code            String?
  city                String?
  state               String?
  allow_login         Boolean      @default(false)
  user_name           String?      @unique
  password            String?
  gst_number          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  buyer_bills         Bills[]      @relation("BuyerBills")
  saler_bills         Bill_items[] @relation("SellerBills")
  transporter_bills   Bills[]      @relation("TransporterBills")

  @@map("users")
}

model Bills {
  id                     Int          @id @default(autoincrement())
  buyerId                Int
  buyer                  Users        @relation("BuyerBills", fields: [buyerId], references: [id])
  transporter_id         Int
  transporter            Users        @relation("TransporterBills", fields: [transporter_id], references: [id])
  bill_date              DateTime     @default(dbgenerated("(curdate())")) @db.Date
  total_amount           Float
  buyer_commision_amount Float  @default(0)
  lorry_number           String?
  lorry_driver_contact   String?
  freight                Float  @default(0)
  advance_freight        Float  @default(0)
  lorry_brokerage        Float  @default(0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  bill_items             Bill_items[] @relation("BillItems")

  @@map("bills")
}

model Bill_items {
  id                      Int      @id @default(autoincrement())
  bill_id                 Int
  bill                    Bills    @relation("BillItems", fields: [bill_id], references: [id], onDelete: Cascade)
  sellerId                Int
  seller                  Users    @relation("SellerBills", fields: [sellerId], references: [id])
  itemId                  Int
  seller_bill_no          String?
  item                    Items    @relation(fields: [itemId], references: [id])
  quantity_bags           Int
  packaging               Int
  weight                  Float
  souda_rate              Float
  amount                  Float
  seller_commision_amount Float  @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("bill_items")
}
